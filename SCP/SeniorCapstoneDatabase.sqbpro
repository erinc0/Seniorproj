er/></table><table schema="main" name="Reviews" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="55"/><column index="3" value="66"/><column index="4" value="67"/><column index="5" value="76"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Shipping" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="69"/><column index="2" value="275"/><column index="3" value="116"/><column index="4" value="195"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Supplier" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="67"/><column index="2" value="143"/><column index="3" value="207"/><column index="4" value="119"/><column index="5" value="159"/><column index="6" value="89"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Edit View OrderIWS">DROP VIEW IF EXISTS &quot;main&quot;.&quot;OrderIWS&quot;;
CREATE VIEW OrderIWS AS
SELECT oi.*, p.SupplierID
FROM OrderItems oi
JOIN Product p ON oi.ProductID = p.ProductID</sql><sql name="Edit Trigger set_orderitem_price">DROP TRIGGER &quot;main&quot;.&quot;set_orderitem_price&quot;;
CREATE TRIGGER set_orderitem_price
AFTER INSERT ON OrderItems
FOR EACH ROW
BEGIN
  UPDATE OrderItems
  SET Subtotal = (SELECT ProdPrice FROM Product WHERE ProductID = NEW.ProductID) * NEW.Quantity
  WHERE OrderItemID = NEW.OrderItemID;
  UPDATE &quot;Order&quot;
  SET Amount = (SELECT sum(Subtotal) FROM OrderItems WHERE OrderID = NEW.OrderID)
  WHERE OrderID = NEW.OrderID;
END</sql><sql name="Edit Trigger update_review_rating*">CREATE TRIGGER update_review_rating
AFTER INSERT ON Reviews
FOR EACH ROW
BEGIN
  UPDATE Product
  SET ProdRating = (SELECT avg(RevRating) FROM Reviews WHERE ProductID = NEW.ProductID)
  WHERE ProductID = NEW.ProductID;
END</sql><sql name="SQL 8*">INSERT INTO ProductShipping (ProductID, ShippingID) VALUES
